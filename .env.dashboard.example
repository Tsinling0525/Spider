# Run the unified dashboardd assistant service from the Spider root.
SPIDER_DASHBOARD_LISTEN_ADDRESS=127.0.0.1:8083
SPIDER_DASHBOARD_DIST=./dashboard/dist
SPIDER_DATA_DIR=./data
SPIDER_API_KEY=

# Memory engine and the copied mailbox adapter use this interpreter.
# Memory requires Python 3.12+ with SQLite FTS5; no pip dependencies are needed.
SPIDER_DASHBOARD_PYTHON=python3

# Personal mailbox connector uses the unmodified Octop Python 3 adapter.
# Optional interpreter path; default is python3. No third-party packages needed.
SPIDER_DASHBOARD_PYTHON=python3

# Optional: imported once into the dashboard's model settings on the first boot.
# Later model changes are made on the page and take precedence over these values.
# Chat Completions compatible model with native tool calling.
# API base includes /v1 if required by your provider.
AGENT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
AGENT_MODEL=
AGENT_MODEL_API_KEY=

# Each voice provider can be hosted locally or remotely.
# Empty base/key inherit the chat provider's base/key.
VOICE_STT_BASE_URL=
VOICE_STT_MODEL=
VOICE_STT_API_KEY=
VOICE_TTS_BASE_URL=
VOICE_TTS_MODEL=
VOICE_TTS_API_KEY=
VOICE_TTS_VOICE=alloy

# Origins allowed during browser development, separated with spaces.
SPIDER_DASHBOARD_ORIGINS="http://localhost:5174 http://127.0.0.1:5174"
