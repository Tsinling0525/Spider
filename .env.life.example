# Public API: loopback requires no key. Non-loopback requires LIFE_API_KEY.
LIFE_LISTEN_ADDRESS=127.0.0.1:8081
# Docker Desktop's Dify must reach this listener via host.docker.internal.
LIFE_ADAPTER_LISTEN_ADDRESS=0.0.0.0:8082
LIFE_ADAPTER_TOKEN=replace-with-a-long-random-token
# LIFE_API_KEY=replace-with-a-long-random-token
LIFE_DIFY_BASE_URL=http://localhost/v1
LIFE_FOOD_DIFY_API_KEY=app-replace-with-published-workflow-key
LIFE_MCP_URL=http://127.0.0.1:3917/mcp
LIFE_MCP_TOKEN=replace-with-mcp-gateway-token
LIFE_PRINCIPAL=spider-life-owner
LIFE_DATA_DIR=./data/life

# Uber MCP: install mcp-uber@1.0.2 and use its absolute executable path.
# Leaving COMMAND/token empty keeps food running and ride operations return 503.
LIFE_UBER_MCP_COMMAND=
LIFE_UBER_MCP_ARGS='[]'
LIFE_UBER_ACCESS_TOKEN=
# One OAuth account per instance. Change USER_ID and data directory for a new account.
LIFE_UBER_USER_ID=spider-life-owner
# Spider explicitly sets the upstream API URL, not just UBER_ENVIRONMENT.
LIFE_UBER_ENVIRONMENT=sandbox
LIFE_UBER_BOOKING_ENABLED=false
