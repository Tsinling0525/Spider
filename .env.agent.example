# agentd includes the contactd APIs and uses the same configuration names.
# Run agentd IN PLACE OF contactd on this port, with an exclusive data directory.
SPIDER_LISTEN_ADDRESS=127.0.0.1:8080
SPIDER_API_KEY=
SPIDER_REVIEWER_ID=principal:owner
SPIDER_DATA_DIR=./data
GMAIL_CREDENTIALS_FILE=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Chat Completions compatible API base, including /v1 when required by provider.
# The selected model must support native function/tool calls.
AGENT_MODEL_BASE_URL=http://127.0.0.1:11434/v1
AGENT_MODEL_API_KEY=
AGENT_MODEL=
AGENT_TIMEZONE=Australia/Sydney
AGENT_MAX_STEPS=16
AGENT_RUN_TIMEOUT=3m

# Optional: used only by the legacy /contact/drafts and Dify human-task APIs.
DIFY_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY=
