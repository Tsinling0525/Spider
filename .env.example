SPIDER_LISTEN_ADDRESS=127.0.0.1:8080
# Optional on loopback; required when listening on a non-loopback address.
# SPIDER_API_KEY=replace-with-a-long-random-value
SPIDER_DATA_DIR=./data

# Development: point directly at the OAuth JSON downloaded from Google Cloud.
GMAIL_CREDENTIALS_FILE=/absolute/path/to/client_secret.json
# Production alternative: configure both values instead of GMAIL_CREDENTIALS_FILE.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URL=http://localhost:8080/auth/google/callback

DIFY_BASE_URL=https://api.dify.ai/v1
# Use http://localhost/v1 and chatflow for local Email Reply Refiner.
DIFY_MODE=workflow
DIFY_API_KEY=
DIFY_USER=spider-mail-service
