# Private WSS endpoint copied from the MCP settings of your Xiaozhi agent.
# Do not commit or print this URL: it contains your endpoint token.
MCP_ENDPOINT=
SPIDER_DASHBOARD_BASE_URL=http://127.0.0.1:8083
# Keep the same channel ID across restarts to continue the same conversation.
SPIDER_XIAOZHI_CHANNEL_ID=personal-xiaozhi
SPIDER_XIAOZHI_CHANNEL_NAME=小智
# Comma-separated IDs of tested, enabled dashboard connectors. Empty = chat only.
SPIDER_XIAOZHI_CONNECTOR_IDS=
# SPIDER_API_KEY is inherited from .env.dashboard by the startup script.

# Wait briefly for a spoken result before returning running. Range 0-15 seconds.
SPIDER_XIAOZHI_WAIT_SECONDS=10
# Set these on dashboardd (in .env.dashboard or its service environment), not cloud args:
# SPIDER_XIAOZHI_VOICE_CHANNELS=personal-xiaozhi
# SPIDER_XIAOZHI_VOICE_CONNECTOR_IDS=the-same-tested-DoorDash-connector-id
